    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicitly approve a proposed action.",
      "html": "<button class=\"ds-primary\">Yes, send it</button>",
      "css": ".ds-primary{font-family:\"Segoe UI Variable\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;font-size:.8125rem;font-weight:600;min-height:42px;padding:10px 17px;border-radius:8px;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;background:var(--action,#512779);color:var(--white,#fff);border:1px solid var(--action,#512779)}.ds-primary:hover:not(:disabled){background:var(--action-hover,#3e1c60)}.ds-primary:focus-visible{outline:3px solid var(--focus,#9575bb);outline-offset:4px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Defer or decline without competing with confirmation.",
      "html": "<button class=\"ds-secondary\">Not now</button>",
      "css": ".ds-secondary{font-family:\"Segoe UI Variable\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;font-size:.8125rem;font-weight:600;min-height:42px;padding:10px 17px;border-radius:8px;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;background:var(--white,#fff);color:var(--action,#512779);border:1px solid var(--secondary-border,#b9a7ce)}.ds-secondary:hover:not(:disabled){background:var(--lavender,#eee9f6)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#9575bb);outline-offset:4px;}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Conversation Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "Anchored question field with a circular send control.",
      "html": "<form class=\"ds-composer\" onsubmit=\"return false\"><input aria-label=\"Ask about Elena's care\" placeholder=\"Ask about Elena’s care…\"/><button type=\"submit\" aria-label=\"Send message\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m4 3 17 9-17 9 3-9Zm3 9h14\"/></svg></button></form>",
      "css": ".ds-composer{display:flex;align-items:center;gap:10px;padding:9px 12px 9px 18px;background:var(--white,#fff);border:1px solid var(--line,#dfd9e9);border-radius:12px}.ds-composer:focus-within{border-color:#a38abe}.ds-composer input{font-family:\"Segoe UI Variable\",\"Segoe UI\",ui-sans-serif,system-ui,sans-serif;flex:1;min-width:0;min-height:40px;width:100%;font-size:.9375rem;color:var(--ink,#20192e);background:transparent;border:0;padding:0;outline:none;caret-color:var(--action,#512779)}.ds-composer input::placeholder{color:#716482;opacity:1}.ds-composer button{display:grid;place-items:center;width:42px;height:42px;flex:none;border:0;border-radius:50%;color:white;background:var(--action,#512779);cursor:pointer;transition:background-color 160ms ease}.ds-composer button:hover{background:var(--action-hover,#3e1c60)}.ds-composer button:focus-visible{outline:3px solid var(--focus,#9575bb);outline-offset:4px;}.ds-composer svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none;width:23px;height:23px}@media(prefers-reduced-motion:reduce){.ds-composer button{transition:none}}"
    },
    {
